    "url": "/oc-panel/integrations/stripe",
    "steps": [
      "[...document.querySelectorAll(\"body *\")].filter(e=>e.children.length===0&&e.textContent.trim()===\"Legacy checkout\").forEach(e=>{let p=e; while(p&&!p.querySelector(\"input[type=checkbox]\")) p=p.parentElement; const i=p&&p.querySelector(\"input[type=checkbox]\"); if(i) i.checked=false;})",
      "(() => new Promise(r => setTimeout(() => { document.querySelectorAll('body *').forEach(el => { if (/^\\s*Unsaved changes/.test(el.innerText || '') && getComputedStyle(el).position === 'fixed') el.remove(); }); r(); }, 300)))()"
    ]
